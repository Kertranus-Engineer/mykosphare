# Supabase (optional — platform runs in local simulation mode without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by v2 ingestion/repositories; never expose as NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
CLOUD_CONNECT_PREVIEW_ONLY=0
# v2 device ingestion uses PER-DEVICE credentials (table grow_device_credentials,
# SHA-256 only). There is no shared ingestion secret any more; see
# docs/architecture/grow-cultivation-loop.md to provision a device key.

# Ingestion
# Generate a unique secret for ingestion API authentication
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGESTION_SECRET=changeme-in-production
INGESTION_RATE_LIMIT=60
